# ─────────────────────────────────────────────────────────────────────
# .env.example — TEMPLATE  (salin ke .env, isi nilai asli)
# File .env DILARANG di-commit → sudah di .gitignore
# ─────────────────────────────────────────────────────────────────────

# ── JWT ──────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=GANTI_DENGAN_RANDOM_STRING_MIN_64_CHAR
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── PostgreSQL Connection String ──────────────────────────────────────
# Neon:     postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:pass@db.XXX.supabase.co:5432/postgres
# Lokal:    postgresql://postgres:password@localhost:5432/ipb_food_hub
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# ── AES-256-GCM Encryption Key ───────────────────────────────────────
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=GANTI_DENGAN_BASE64_32_BYTE

# ── RSA Keypair Digital Signature ────────────────────────────────────
# Generate: cd backend && python -m app.auth.digital_signature
RSA_PRIVATE_KEY_PATH=./keys/private.pem
RSA_PUBLIC_KEY_PATH=./keys/public.pem

# ── AAA Accounting Log ────────────────────────────────────────────────
AAA_LOG_DIR=./logs

# ── CORS (opsional) ───────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
